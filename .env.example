# Set this to the GA4 web data stream Measurement ID (for example, G-XXXXXXXXXX).
# Leave blank to build without analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# This is a static, public marketing website.
# Deploy it using your existing domain and Vercel project.

# Only needed if the unused custom form (/api/contact) is re-enabled. The live contact page uses a Google Form.
# Contact form delivery (Resend, https://resend.com). Without these the form falls back to the visitor's email app.
# CONTACT_FROM_EMAIL must be on a domain verified in Resend, e.g. "INRI Website <estimates@inripaintwall.com>".
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Optional: where requests are delivered (defaults to the business email).
CONTACT_TO_EMAIL=

# Optional: online booking page (Calendly, Cal.com, Square Appointments...) shows a "Book a time" button.
NEXT_PUBLIC_BOOKING_URL=
# Optional: your Google "write a review" link shows a "Leave a review" button.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
# Optional: Bing Webmaster Tools verification token.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
